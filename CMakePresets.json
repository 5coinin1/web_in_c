{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default (OpenSSL in a standard location)",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "windows-mingw",
      "displayName": "Windows MinGW (MSYS2)",
      "description": "Edit the paths below if your MSYS2 install differs (default C:/msys64).",
      "inherits": "default",
      "generator": "MinGW Makefiles",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "C:/msys64/mingw64/bin/gcc.exe",
        "CMAKE_MAKE_PROGRAM": "C:/msys64/mingw64/bin/mingw32-make.exe",
        "CMAKE_PREFIX_PATH": "C:/msys64/mingw64",
        "OPENSSL_ROOT_DIR": "C:/msys64/mingw64"
      }
    },
    {
      "name": "asan",
      "displayName": "Debug + ASan/UBSan (GCC/Clang on Linux/macOS)",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build-asan",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "WCHAT_SANITIZE": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "windows-mingw", "configurePreset": "windows-mingw" },
    { "name": "asan", "configurePreset": "asan" }
  ]
}
